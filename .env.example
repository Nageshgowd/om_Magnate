# Copy to .env for local development. On Vercel, add the same names under Project Settings > Environment Variables.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=om-magnet
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The first admin is created automatically when the users collection is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
